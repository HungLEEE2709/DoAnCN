}
component EnemyInfo {
    FP Time;
    FP ChangeDirectionTime;
    FPVector2 Direction;

    FPVector2 SpawnPosition;
    FP Radius;
    FP Health;
    FP CurrentHealth;
    FP AttackRange;
    FP DetectionRange;
    FP Damage;
    bool IsAttacking;
