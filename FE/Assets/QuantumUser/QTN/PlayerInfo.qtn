component PlayerInfo 
{
    player_ref PlayerRef;
    FP Damage;
    FP Health;
    FP CurrentHealth;
    FP MaxHealth;
    FP Ki;
    FP MaxKi;
    FP Speed;
    bool IsAttacking;
