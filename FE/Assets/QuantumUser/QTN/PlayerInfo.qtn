component PlayerInfo 
{
    player_ref PlayerRef;
    FP Damage;
    FP Health;
    FP CurrentHealth;
    FP MaxHealth;
    FP Ki;
    FP MaxKi;
    FP Speed;
    bool IsAttacking;
    int AttackTimer;
    
    // New Stats
    FP SucManh;
    FP TiemNang;
}
component EnemyInfo {
    FP Time;
    FP ChangeDirectionTime;
    FPVector2 Direction;

    FPVector2 SpawnPosition;
    FP Radius;
    FP Health;
    FP CurrentHealth;
    FP AttackRange;
    FP DetectionRange;
    FP Damage;
    bool IsAttacking;
    bool IsDead;
    EntityRef PlayerEntity;
    FP AttackCooldown;

    // Rewards
    FP RewardSucManh;
    FP RewardTiemNang;
    
    // Item Drop
    asset_ref<EntityPrototype> DropItemPrototype; 
    int DropItemId;      
    int DropQuantity;   
    int DropChance;     
}
component ItemInfo {
    int ItemId;
    int Quantity;
    bool Collected;
}
