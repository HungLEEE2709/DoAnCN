<%- include('layout', { body: ` <div class="auth-form">
    <h2>Quên Mật Khẩu</h2>
    <p style="text-align: center; color: #aaa; margin-bottom: 20px;">Nhập Email đã đăng ký để đặt lại mật khẩu.</p>

    <% if (locals.message) { %>
        <div class="alert warning">
            <%= message %>
        </div>
        <% } %>

            <form action="/forgot-password" method="POST">
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" required placeholder="email@example.com">
                </div>
                <button type="submit" class="btn-submit">Gửi Yêu Cầu</button>
            </form>

            <p class="note" style="text-align: center; margin-top: 20px;">
                <a href="/login" style="color: var(--primary-color);">Quay lại Đăng Nhập</a>
            </p>
            </div>
            ` }) %>